[
  {"file":"data/new_script_dat.pac","offset":11338,"length":4,"ja":"審判","en":"Ref"},
  {"file":"data/new_script_dat.pac","offset":11343,"length":6,"ja":"勝者、","en":"Won:"},
  {"file":"data/new_script_dat.pac","offset":11350,"length":4,"ja":"！！","en":"!!"},
  {"file":"data/new_script_dat.pac","offset":11355,"length":10,"ja":"＊＊＊＊＊","en":"*****"},
  {"file":"data/new_script_dat.pac","offset":11366,"length":26,"ja":"よっしゃ！　ロックだぜ！！","en":"Yeah! Rock on!!"},
  {"file":"data/new_script_dat.pac","offset":11393,"length":14,"ja":"竜切りジャック","en":"Jack"},
  {"file":"data/new_script_dat.pac","offset":11408,"length":61,"ja":"ああ…見事だよ、少年……。\nその調子でがんばってくれたまえ…。","en":"Well done, young man...\nKeep up the good work..."},
  {"file":"data/new_script_dat.pac","offset":11470,"length":14,"ja":"竜切りジャック","en":"Jack"},
  {"file":"data/new_script_dat.pac","offset":11485,"length":67,"ja":"世界には強いドラゴンが山ほどいる。\nエジキにされぬよう気をつけて…。","en":"Many strong dragons roam the world.\nDon't become their prey..."},
  {"file":"data/new_script_dat.pac","offset":11553,"length":10,"ja":"＊＊＊＊＊","en":"*****"},
  {"file":"data/new_script_dat.pac","offset":11564,"length":32,"ja":"なんかイヤな送り文句だなァ……。","en":"That's a grim send-off..."},
  {"file":"data/new_script_dat.pac","offset":11597,"length":6,"ja":"アヤカ","en":"Ayaka"},
  {"file":"data/new_script_dat.pac","offset":11604,"length":30,"ja":"ハイ、ごくろーさん！！　これで","en":"Great job! Now you're"},
  {"file":"data/new_script_dat.pac","offset":11635,"length":22,"ja":"も立派なテイマーだね！","en":"a real Tamer!"},
  {"file":"data/new_script_dat.pac","offset":11658,"length":10,"ja":"＊＊＊＊＊","en":"*****"},
  {"file":"data/new_script_dat.pac","offset":11669,"length":43,"ja":"よせやい。……っていうか、\nなんでイキナリ？","en":"Aw, shucks...\nWhy all of a sudden?"},
  {"file":"data/new_script_dat.pac","offset":11713,"length":6,"ja":"アヤカ","en":"Ayaka"},
  {"file":"data/new_script_dat.pac","offset":11720,"length":63,"ja":"あ、言ってなかった？　これからは\nいつでも竜斗台で戦えるんだよ。","en":"Oh, didn't I say? Now you can\nbattle at the Arena anytime."},
  {"file":"data/new_script_dat.pac","offset":11784,"length":6,"ja":"アヤカ","en":"Ayaka"},
  {"file":"data/new_script_dat.pac","offset":11791,"length":30,"ja":"ただし、相手がいればだけどね。","en":"If you can find an opponent."},
  {"file":"data/new_script_dat.pac","offset":11822,"length":6,"ja":"トント","en":"Tonto"},
  {"file":"data/new_script_dat.pac","offset":11829,"length":47,"ja":"知り合いをよべば対戦が\nできるというわけジャな。","en":"Invite a friend,\nand you can battle."},
  {"file":"data/new_script_dat.pac","offset":11877,"length":6,"ja":"アヤカ","en":"Ayaka"},
  {"file":"data/new_script_dat.pac","offset":11884,"length":57,"ja":"タイトルメニューに「通信対戦」の\nコマンドがふえてるから、","en":"There's a new Wireless Battle\noption on the title menu,"},
  {"file":"data/new_script_dat.pac","offset":11942,"length":6,"ja":"アヤカ","en":"Ayaka"},
  {"file":"data/new_script_dat.pac","offset":11949,"length":51,"ja":"じまんのチームができたら\nレッツ対戦！　なーんてね。","en":"Build your dream team,\nthen let's battle!"},
  {"file":"data/new_script_dat.pac","offset":12001,"length":6,"ja":"アヤカ","en":"Ayaka"},
  {"file":"data/new_script_dat.pac","offset":12008,"length":63,"ja":"それに対戦に勝つとドラゴンメダルが\nもらえるんだって…お得だね！","en":"Win battles to earn Dragon Medals...\nWhat a deal!"},
  {"file":"data/new_script_dat.pac","offset":12072,"length":10,"ja":"＊＊＊＊＊","en":"*****"},
  {"file":"data/new_script_dat.pac","offset":12083,"length":32,"ja":"ふうん…わかった、おぼえとくよ！","en":"Got it. I'll remember that!"},
  {"file":"data/new_script_dat.pac","offset":12116,"length":34,"ja":"【通信対戦】ができるようになった。","en":"[Wireless Battle] unlocked."},
  {"file":"data/new_script_dat.pac","offset":12151,"length":6,"ja":"アヤカ","en":"Ayaka"},
  {"file":"data/new_script_dat.pac","offset":12158,"length":57,"ja":"ハイ、それじゃ、さっきの戦い。\n陽国の入国許可証でたよー！","en":"All right, your last battle\nearned a Youkoku entry pass!"},
  {"file":"data/new_script_dat.pac","offset":12216,"length":31,"ja":"【入国許可証　1】を手に入れた。","en":"[Entry Pass 1] obtained."},
  {"file":"data/new_script_dat.pac","offset":12248,"length":10,"ja":"＊＊＊＊＊","en":"*****"},
  {"file":"data/new_script_dat.pac","offset":12259,"length":45,"ja":"陽国！？　クインズランドじゃ\nないのかよ？？？","en":"Youkoku?!\nWhat about Queensland?!"},
  {"file":"data/new_script_dat.pac","offset":12305,"length":6,"ja":"アヤカ","en":"Ayaka"},
  {"file":"data/new_script_dat.pac","offset":12312,"length":57,"ja":"あわてなーい。ここは世界の情報が\n集まるっていったでしょ？","en":"Easy! I told you this place\nis a world info hub, right?"},
  {"file":"data/new_script_dat.pac","offset":12370,"length":6,"ja":"アヤカ","en":"Ayaka"},
  {"file":"data/new_script_dat.pac","offset":12377,"length":39,"ja":"さっき見た新牙王！\n新聞の記事によると…","en":"Shingaoh!\nThe news says..."},
  {"file":"data/new_script_dat.pac","offset":12417,"length":6,"ja":"アヤカ","en":"Ayaka"},
  {"file":"data/new_script_dat.pac","offset":12424,"length":49,"ja":"自分のことを「七賢竜のキビト」と\nいったんだって！","en":"He says he's Chosen\nof the Seven Wise Dragons!"},
  {"file":"data/new_script_dat.pac","offset":12474,"length":10,"ja":"＊＊＊＊＊","en":"*****"},
  {"file":"data/new_script_dat.pac","offset":12485,"length":20,"ja":"え…それって……！？","en":"Oh... you mean...?"},
  {"file":"data/new_script_dat.pac","offset":12506,"length":6,"ja":"アヤカ","en":"Ayaka"},
  {"file":"data/new_script_dat.pac","offset":12513,"length":69,"ja":"そ！　ユージーンさんがいった言葉と\n同じ！　キョーミでてきたっしょ！？","en":"Yep! Same words Eugene used!\nGetting curious now, huh?!"},
  {"file":"data/new_script_dat.pac","offset":12583,"length":10,"ja":"＊＊＊＊＊","en":"*****"},
  {"file":"data/new_script_dat.pac","offset":12594,"length":53,"ja":"陽国の新牙王か……なるほどね！\nたしかに面白そうだ！！","en":"Shingaoh of Youkoku...\nNow that's interesting!"},
  {"file":"data/new_script_dat.pac","offset":12648,"length":6,"ja":"トント","en":"Tonto"},
  {"file":"data/new_script_dat.pac","offset":12655,"length":22,"ja":"行くか…陽国とやらに！","en":"Let's go to Youkoku!"},
  {"file":"data/new_script_dat.pac","offset":13061,"length":22,"ja":"さて、試合といこうか！","en":"Let's battle!"},
  {"file":"data/new_script_dat.pac","offset":13084,"length":6,"ja":"アヤカ","en":"Ayaka"},
  {"file":"data/new_script_dat.pac","offset":13091,"length":69,"ja":"えーと、ルールによれば正々堂々と、\nテイマーとしてのれいぎをわきまえ…","en":"Rules say fight fair, and show\nproper Tamer manners..."},
  {"file":"data/new_script_dat.pac","offset":13172,"length":61,"ja":"あー、とにかく相手のドラゴン\nたおせばいいんだろ？　おっしゃ！","en":"So I just beat their Dragons?\nLet's go!"},
  {"file":"data/new_script_dat.pac","offset":13234,"length":6,"ja":"アヤカ","en":"Ayaka"},
  {"file":"data/new_script_dat.pac","offset":13241,"length":51,"ja":"相手は…竜切りジャック？\nなんかぶっそうな名前……。","en":"Dragon-Slayer Jack?\nThat's a scary name..."},
  {"file":"data/new_script_dat.pac","offset":13293,"length":6,"ja":"トント","en":"Tonto"},
  {"file":"data/new_script_dat.pac","offset":13300,"length":49,"ja":"リンドブルムの使い手らしいノ。\nゆだんは禁物ジャ。","en":"He uses Lindblum.\nStay sharp."},
  {"file":"data/new_script_dat.pac","offset":13445,"length":32,"ja":"今は特に試合もないみたいだな…。","en":"No matches right now..."},
  {"file":"data/new_script_dat.pac","offset":13861,"length":28,"ja":"それじゃあ、やってみよっか！","en":"Okay, let's do this!"},
  {"file":"data/new_script_dat.pac","offset":13890,"length":14,"ja":"竜切りジャック","en":"Jack"},
  {"file":"data/new_script_dat.pac","offset":13905,"length":57,"ja":"子供か…クク、リンドブルムたちが\nうれしそうにしてるよ…。","en":"A kid... My Lindblums\nlook happy..."},
  {"file":"data/new_script_dat.pac","offset":13963,"length":14,"ja":"竜切りジャック","en":"Jack"},
  {"file":"data/new_script_dat.pac","offset":13978,"length":57,"ja":"がんじがらめにして、カマイタチの\nエジキにしたいってね…。","en":"They'll bind you up and make you\nWhirlwind's prey..."},
  {"file":"data/new_script_dat.pac","offset":14047,"length":26,"ja":"う……なんかヤな感じ……。","en":"Ugh... This feels bad..."},
  {"file":"data/new_script_dat.pac","offset":14074,"length":4,"ja":"審判","en":"Ref"},
  {"file":"data/new_script_dat.pac","offset":14079,"length":22,"ja":"それでは、試合開始！！","en":"Let the match begin!!"},
  {"file":"data/new_script_dat.pac","offset":14197,"length":34,"ja":"もう少し準備をととのえておこっか。","en":"Let's get ready first."},
  {"file":"data/new_script_dat.pac","offset":14640,"length":4,"ja":"審判","en":"Ref"},
  {"file":"data/new_script_dat.pac","offset":14645,"length":6,"ja":"勝者、","en":"Won:"},
  {"file":"data/new_script_dat.pac","offset":14668,"length":26,"ja":"よっしゃ！　ロックだぜ！！","en":"Yeah! Rock on!!"},
  {"file":"data/new_script_dat.pac","offset":14695,"length":14,"ja":"竜切りジャック","en":"Jack"},
  {"file":"data/new_script_dat.pac","offset":14710,"length":61,"ja":"ああ…見事だよ、少年……。\nその調子でがんばってくれたまえ…。","en":"Well done, young man...\nKeep up the good work..."},
  {"file":"data/new_script_dat.pac","offset":14772,"length":14,"ja":"竜切りジャック","en":"Jack"},
  {"file":"data/new_script_dat.pac","offset":14787,"length":67,"ja":"陽国は都会だが兵隊がいばっている。\nエジキにされぬよう気をつけて…。","en":"Youkoku is modern, but its soldiers\nbully folks. Watch out..."},
  {"file":"data/new_script_dat.pac","offset":14866,"length":32,"ja":"なんかイヤな送り文句だなァ……。","en":"That's a grim send-off..."},
  {"file":"data/new_script_dat.pac","offset":17046,"length":67,"ja":"つか、よその国行くのに、いちいち\n竜斗台ってのもメンドくさいよなー。","en":"Arena tests for every country\nare a pain."},
  {"file":"data/new_script_dat.pac","offset":17125,"length":65,"ja":"さっさとクインズランド行こうよ。\nユージーン、まちくたびれてるぜ。","en":"Let's get to Queensland!\nEugene's waited long enough."},
  {"file":"data/new_script_dat.pac","offset":17191,"length":6,"ja":"アヤカ","en":"Ayaka"},
  {"file":"data/new_script_dat.pac","offset":17198,"length":18,"ja":"ゲ…またボツ……。","en":"Rejected again..."},
  {"file":"data/new_script_dat.pac","offset":17228,"length":63,"ja":"なんだ、まだ記事送ってんの？\nどうせ、にぎりつぶされてるんだろ？","en":"Still sending articles?\nThey'll bury them, right?"},
  {"file":"data/new_script_dat.pac","offset":17292,"length":6,"ja":"アヤカ","en":"Ayaka"},
  {"file":"data/new_script_dat.pac","offset":17299,"length":67,"ja":"それでも、送んの！　よまれずとも\n記録は記録。お父ちゃんもいってた！","en":"I'll keep sending them! A record's\na record, unread. Dad said so!"},
  {"file":"data/new_script_dat.pac","offset":17367,"length":6,"ja":"トント","en":"Tonto"},
  {"file":"data/new_script_dat.pac","offset":17374,"length":45,"ja":"お父ちゃんも\nボツ続きの人だったようジャな…。","en":"Your dad got rejected a lot too..."},
  {"file":"data/new_script_dat.pac","offset":17420,"length":6,"ja":"アヤカ","en":"Ayaka"},
  {"file":"data/new_script_dat.pac","offset":17427,"length":47,"ja":"あ、伝書竜。ちょうどいいや、\n次の記事……あれ？","en":"A message Dragon! Great.\nMy article... Huh?"},
  {"file":"data/new_script_dat.pac","offset":17475,"length":6,"ja":"アヤカ","en":"Ayaka"},
  {"file":"data/new_script_dat.pac","offset":17482,"length":53,"ja":"なんかとどけてくれたよ…\nヤナガさんからだ……これ！？","en":"Something arrived...\nFrom Yanaga... What?!"},
  {"file":"data/new_script_dat.pac","offset":17547,"length":47,"ja":"テイマー免許だ！　本免許！\n仮免卒業ってこと！？","en":"A real Tamer license!\nNo more rookie rank?!"},
  {"file":"data/new_script_dat.pac","offset":17595,"length":30,"ja":"【テイマー免許】を手に入れた。","en":"[Tamer License] obtained."},
  {"file":"data/new_script_dat.pac","offset":17626,"length":6,"ja":"アヤカ","en":"Ayaka"},
  {"file":"data/new_script_dat.pac","offset":17633,"length":63,"ja":"えーと…君のがんばりに期待する\n……だって。なんともあっさりと。","en":"'We expect great things from you.'\nPretty brief."},
  {"file":"data/new_script_dat.pac","offset":17697,"length":6,"ja":"アヤカ","en":"Ayaka"},
  {"file":"data/new_script_dat.pac","offset":17704,"length":59,"ja":"でもなんで、わざわざ伝書竜に…\nネストを通せば確実なのに…？","en":"Why send it by message Dragon?\nThe Nest is more reliable..."},
  {"file":"data/new_script_dat.pac","offset":17764,"length":6,"ja":"トント","en":"Tonto"},
  {"file":"data/new_script_dat.pac","offset":17771,"length":32,"ja":"……なにか不都合でもあるのか…？","en":"...Could something be wrong...?"},
  {"file":"data/new_script_dat.pac","offset":17804,"length":6,"ja":"アヤカ","en":"Ayaka"},
  {"file":"data/new_script_dat.pac","offset":17811,"length":53,"ja":"これでレベル１０までドラゴンを\n育てられる。やったね、","en":"Dragons can reach Lv. 10 now!\nWe did it, "},
  {"file":"data/new_script_dat.pac","offset":17868,"length":10,"ja":"＊＊＊＊＊","en":"*****"},
  {"file":"data/new_script_dat.pac","offset":17879,"length":61,"ja":"おっしゃあ！　よーし、これで\nクインズランドになぐりこみだあ！","en":"Great! Off to Queensland\nto take it by storm!"},
  {"file":"data/new_script_dat.pac","offset":17941,"length":6,"ja":"アヤカ","en":"Ayaka"},
  {"file":"data/new_script_dat.pac","offset":17948,"length":65,"ja":"あ、そのことだけど、進路変更ね。\nお次はスベロチカにまいりまーす！","en":"Change of plans!\nNext stop: Sberochka!"},
  {"file":"data/new_script_dat.pac","offset":18014,"length":10,"ja":"＊＊＊＊＊","en":"*****"},
  {"file":"data/new_script_dat.pac","offset":18025,"length":59,"ja":"うおお…ってなんだよそれ！\nクインズランドっていってるだろ！","en":"What?! I said Queensland!"},
  {"file":"data/new_script_dat.pac","offset":18085,"length":6,"ja":"アヤカ","en":"Ayaka"},
  {"file":"data/new_script_dat.pac","offset":18092,"length":61,"ja":"おちつきなさいって。わかる？\nテイマーが国家間を移動するには…","en":"Calm down. Tamers traveling\nbetween countries have to..."},
  {"file":"data/new_script_dat.pac","offset":18154,"length":6,"ja":"アヤカ","en":"Ayaka"},
  {"file":"data/new_script_dat.pac","offset":18161,"length":59,"ja":"必ず竜斗台で、行く先にあわせた\n審査を受けなきゃならないの。","en":"We need an Arena test for\neach country we visit."},
  {"file":"data/new_script_dat.pac","offset":18221,"length":10,"ja":"＊＊＊＊＊","en":"*****"},
  {"file":"data/new_script_dat.pac","offset":18232,"length":59,"ja":"そんなのわかってるよ。だから\nなんでクインズランドじゃなく…","en":"I know! Why not go to\nQueensland instead...?"},
  {"file":"data/new_script_dat.pac","offset":18292,"length":6,"ja":"アヤカ","en":"Ayaka"},
  {"file":"data/new_script_dat.pac","offset":18299,"length":57,"ja":"だーかーらー、竜抜戦の\nキビトったってテイマーなんだから…","en":"Even a Dragon Duel Chosen\nis still a Tamer..."},
  {"file":"data/new_script_dat.pac","offset":18357,"length":6,"ja":"トント","en":"Tonto"},
  {"file":"data/new_script_dat.pac","offset":18364,"length":55,"ja":"そうか！　ユージーンもここを\n通っとるというわけジャな！","en":"So Eugene came through here too!"},
  {"file":"data/new_script_dat.pac","offset":18420,"length":6,"ja":"アヤカ","en":"Ayaka"},
  {"file":"data/new_script_dat.pac","offset":18427,"length":59,"ja":"ご明察！　ユージーンさんらしい\n一行を見たって人がいたのよ！","en":"Right! Someone saw a group\nthat looked like Eugene's!"},
  {"file":"data/new_script_dat.pac","offset":18487,"length":6,"ja":"アヤカ","en":"Ayaka"},
  {"file":"data/new_script_dat.pac","offset":18494,"length":61,"ja":"数日前にスベロチカ行きの審査を\n受けたんだって。いるならそこ！","en":"They took that test a few days ago.\nThey must be there!"},
  {"file":"data/new_script_dat.pac","offset":18556,"length":6,"ja":"トント","en":"Tonto"},
  {"file":"data/new_script_dat.pac","offset":18563,"length":65,"ja":"なるほど…あるいはスベロチカに\n次のキビトがいるのかもしれんな…。","en":"Maybe the next Chosen\nis in Sberochka..."},
  {"file":"data/new_script_dat.pac","offset":18629,"length":6,"ja":"アヤカ","en":"Ayaka"},
  {"file":"data/new_script_dat.pac","offset":18636,"length":53,"ja":"そゆことそゆこと！　そゆことなんで\nさっそく……あれ、","en":"That's right! So let's get going...\nWait..."},
  {"file":"data/new_script_dat.pac","offset":18706,"length":61,"ja":"おそいよ！　なにやってんの！\nさっさと行くぞー、スベロチカ！！","en":"You're late! What took you?!\nLet's go, Sberochka!!"}
] 
